# Allow application source, documentation and the requested dashboard dataset.
/*
!/.gitignore
!/README.md
!/email_dashboard.html
!/supporting-files/
/supporting-files/*
!/supporting-files/prepare_email_dashboard.py
!/supporting-files/prepare_email_reader.py
!/supporting-files/groupsales_latest_100_conversations.json
!/supporting-files/agent_contact_sheet.csv
!/supporting-files/conversation_contacts_enriched.csv
!/supporting-files/signature_review_source.json
!/supporting-files/signature_image_candidates.json
!/supporting-files/signature_images/

!/email-dashboard/

# Keep other supporting files and generated applications local.
/email-dashboard/dist/
/email-dashboard/.data-app-offline/
/email-dashboard/.openai/
**/node_modules/
**/__pycache__/
**/.env
**/.env.*
**/~$*
