# Allow application source, documentation and the requested dashboard dataset.
/*
!/.gitignore
!/README.md
!/supporting-files/
/supporting-files/*
!/supporting-files/prepare_email_dashboard.py
!/supporting-files/prepare_email_reader.py
!/email-dashboard/

# Keep additional source files and generated applications local.
/email-dashboard/dist/
/email-dashboard/.data-app-offline/
/email-dashboard/.openai/
**/node_modules/
**/__pycache__/
**/.env
**/.env.*
**/~$*
